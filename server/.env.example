PORT=3001
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# PostgreSQL Configuration
# You can provide a full DATABASE_URL or individual PG variables:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/store_db
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=store_db

# Embedded/Local PostgreSQL storage path (used when no external PostgreSQL server is specified)
PGDATA_PATH=data/pgdata

# Legacy SQLite database path (for data migration)
DB_PATH=data/store.sqlite

# Seed a small, clearly labelled dataset so every team member can exercise the
# dashboard and CRUD modules immediately after copying this file to .env.
ENABLE_DEMO_DATA=true
SUPPORT_NUM_CTX=8192
ADMIN_DEFAULT_NUM_CTX=16384
SUPPORT_NUM_PREDICT=384
ADMIN_NUM_PREDICT=1024
OLLAMA_TIMEOUT_MS=120000
GENERATION_QUEUE_MAX=4
GENERATION_QUEUE_WAIT_MS=30000
COOKIE_SECURE=false
