{
  "manifest_version": 3,
  "name": "OmniCart Social Auto-Poster & Inspiration Bridge",
  "version": "1.0.0",
  "description": "Tự động đăng bài thật lên Facebook cá nhân John Harper và TikTok @harutv666 an toàn qua tab trình duyệt, không chiếm chuột/bàn phím, quét cảm hứng viral thật.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.facebook.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-admin-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": ["content-facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": ["content-tiktok.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniCart Social Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
