{
  "name": "store-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "preview": "vite preview",
    "dev:api": "npm --prefix server run dev",
    "dev:api:node-legacy": "npm --prefix server run dev",
    "dev:api:cs": "dotnet watch --project server-dotnet run --urls http://127.0.0.1:5000",
    "build:api:cs": "dotnet build server-dotnet/server-dotnet.csproj",
    "test:api": "npm --prefix server test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "26.1.0",
    "vite": "^8.3.0"
  }
}
