# Connection string for Microsoft SQL Server
# Máy mới chỉ cần SQL Server đang Running, API sẽ tự tạo database StoreDb + tables + seed.
# Thêm Encrypt=False để tránh lỗi chứng chỉ self-signed trên driver ODBC 18 / SqlClient mới.
ConnectionStrings__StoreDb=Server=localhost;Database=StoreDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;
# Đổi instance nếu dùng SQLEXPRESS: Server=localhost\SQLEXPRESS;... (hoặc đặt biến môi trường SQL_SERVER)
# Đổi tên DB nếu cần: đặt biến môi trường SQL_DATABASE=TênDbKhác
